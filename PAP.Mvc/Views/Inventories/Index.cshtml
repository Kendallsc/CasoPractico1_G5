@model IEnumerable<PAP.DataAccess.Inventory>
@using PAP.Mvc.Helpers

@{
    ViewBag.Title = "Inventario";
    var rows = Model?.ToList() ?? new List<PAP.DataAccess.Inventory>();
    var booksOptions = (IEnumerable<SelectListItem>)ViewBag.BooksOptions;
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">Inventario</h1>
            <p class="text-muted mb-0">@rows.Count registro@(rows.Count == 1 ? "" : "s")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="search" id="crudFilter" class="form-control form-control-sm" placeholder="Filtrar..." />
            <button type="button" class="btn btn-primary btn-sm" data-crud="create">Nuevo</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="crudTable">
            <thead class="table-dark">
                <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Libro</th>
                        <th scope="col">Existencias</th>
                        <th scope="col">Reorden</th>
                        <th scope="col">Reabastecido</th>
                    <th scope="col" class="text-center">Editar</th>
                    <th scope="col" class="text-center">Eliminar</th>
                    <th scope="col" class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No hay registros.</td>
                    </tr>
                }
                @foreach (var x in rows)
                {
                    var item = new
            {
                Id = x.Id,
                BookId = x.BookId,
                BookIdText = (x.Book == null ? "" : x.Book.Title),
                QuantityInStock = x.QuantityInStock,
                ReorderLevel = x.ReorderLevel,
                LastRestockedAt = Fmt.DateTimeLocal(x.LastRestockedAt),
                __keys = new { id = x.Id }
            };
                    <tr data-item="@(Newtonsoft.Json.JsonConvert.SerializeObject(item))">
                    <td>@(x.Id)</td>
                    <td>@(x.Book == null ? "-" : x.Book.Title)</td>
                    <td>@(x.QuantityInStock)@if (x.QuantityInStock <= x.ReorderLevel) { <span class="badge text-bg-warning ms-1">Bajo</span> }</td>
                    <td>@(x.ReorderLevel)</td>
                    <td>@(x.LastRestockedAt.HasValue ? Fmt.Pretty(x.LastRestockedAt) : "-")</td>
                        <td class="text-center"><button type="button" class="btn btn-outline-primary btn-sm" data-crud="edit">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm" data-crud="delete">Eliminar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-info btn-sm" data-crud="detail">Detalle</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "Inventories", FormMethod.Post, new { id = "createModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle">Nuevo registro: Inventario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="create_BookId">Libro <span class="text-danger">*</span></label>
                <select class="form-select" id="create_BookId" name="BookId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in booksOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_QuantityInStock">Existencias <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="create_QuantityInStock" name="QuantityInStock" step="1" min="0" required value="0" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_ReorderLevel">Nivel de reorden <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="create_ReorderLevel" name="ReorderLevel" step="1" min="0" required value="5" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_LastRestockedAt">Ultimo reabastecimiento</label>
                <input type="datetime-local" class="form-control" id="create_LastRestockedAt" name="LastRestockedAt" />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "Inventories", FormMethod.Post, new { id = "editModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Editar inventario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
            <input type="hidden" id="edit_Id" name="Id" />
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="edit_BookId">Libro <span class="text-danger">*</span></label>
                <select class="form-select" id="edit_BookId" name="BookId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in booksOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_QuantityInStock">Existencias <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_QuantityInStock" name="QuantityInStock" step="1" min="0" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_ReorderLevel">Nivel de reorden <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_ReorderLevel" name="ReorderLevel" step="1" min="0" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_LastRestockedAt">Ultimo reabastecimiento</label>
                <input type="datetime-local" class="form-control" id="edit_LastRestockedAt" name="LastRestockedAt" />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Inventario',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'BookIdText', label: 'Libro', type: 'text' },
                { key: 'QuantityInStock', label: 'Existencias', type: 'text' },
                { key: 'ReorderLevel', label: 'Nivel de reorden', type: 'text' },
                { key: 'LastRestockedAt', label: 'Ultimo reabastecimiento', type: 'datetime' }
            ]
        });
    </script>
}
