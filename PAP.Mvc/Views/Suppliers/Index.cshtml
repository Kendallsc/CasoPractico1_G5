@model IEnumerable<PAP.DataAccess.Supplier>
@using PAP.Mvc.Helpers

@{
    ViewBag.Title = "Proveedores";
    var rows = Model?.ToList() ?? new List<PAP.DataAccess.Supplier>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">Proveedores</h1>
            <p class="text-muted mb-0">@rows.Count registro@(rows.Count == 1 ? "" : "s")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="search" id="crudFilter" class="form-control form-control-sm" placeholder="Filtrar..." />
            <button type="button" class="btn btn-primary btn-sm" data-crud="create">Nuevo</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="crudTable">
            <thead class="table-dark">
                <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Contacto</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Telefono</th>
                        <th scope="col">Estado</th>
                    <th scope="col" class="text-center">Editar</th>
                    <th scope="col" class="text-center">Eliminar</th>
                    <th scope="col" class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No hay registros.</td>
                    </tr>
                }
                @foreach (var x in rows)
                {
                    var item = new
            {
                Id = x.Id,
                Name = x.Name,
                ContactName = x.ContactName,
                Email = x.Email,
                Phone = x.Phone,
                Address = x.Address,
                IsActive = x.IsActive,
                __keys = new { id = x.Id }
            };
                    <tr data-item="@(Newtonsoft.Json.JsonConvert.SerializeObject(item))">
                    <td>@(x.Id)</td>
                    <td>@(x.Name)</td>
                    <td>@(Fmt.Dash(x.ContactName))</td>
                    <td>@(Fmt.Dash(x.Email))</td>
                    <td>@(Fmt.Dash(x.Phone))</td>
                    <td>@if (x.IsActive) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Inactivo</span> }</td>
                        <td class="text-center"><button type="button" class="btn btn-outline-primary btn-sm" data-crud="edit">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm" data-crud="delete">Eliminar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-info btn-sm" data-crud="detail">Detalle</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "Suppliers", FormMethod.Post, new { id = "createModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle">Nuevo registro: Proveedor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="create_Name">Nombre <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_Name" name="Name" maxlength="200" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_ContactName">Contacto</label>
                <input type="text" class="form-control" id="create_ContactName" name="ContactName" maxlength="150" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Email">Correo</label>
                <input type="email" class="form-control" id="create_Email" name="Email" maxlength="150" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Phone">Telefono</label>
                <input type="text" class="form-control" id="create_Phone" name="Phone" maxlength="30" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Address">Direccion</label>
                <input type="text" class="form-control" id="create_Address" name="Address" maxlength="300" />
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="create_IsActive" name="IsActive" value="true" checked />
                    <label class="form-check-label" for="create_IsActive">Activo</label>
                </div>
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "Suppliers", FormMethod.Post, new { id = "editModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Editar proveedor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
            <input type="hidden" id="edit_Id" name="Id" />
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="edit_Name">Nombre <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_Name" name="Name" maxlength="200" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_ContactName">Contacto</label>
                <input type="text" class="form-control" id="edit_ContactName" name="ContactName" maxlength="150" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Email">Correo</label>
                <input type="email" class="form-control" id="edit_Email" name="Email" maxlength="150" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Phone">Telefono</label>
                <input type="text" class="form-control" id="edit_Phone" name="Phone" maxlength="30" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Address">Direccion</label>
                <input type="text" class="form-control" id="edit_Address" name="Address" maxlength="300" />
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="edit_IsActive" name="IsActive" value="true" />
                    <label class="form-check-label" for="edit_IsActive">Activo</label>
                </div>
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Proveedor',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'Name', label: 'Nombre', type: 'text' },
                { key: 'ContactName', label: 'Contacto', type: 'text' },
                { key: 'Email', label: 'Correo', type: 'text' },
                { key: 'Phone', label: 'Telefono', type: 'text' },
                { key: 'Address', label: 'Direccion', type: 'text' },
                { key: 'IsActive', label: 'Activo', type: 'bool' }
            ]
        });
    </script>
}
