@*
    Ejemplo: Model Binding
    Los names de los inputs coinciden con las propiedades de Book; al hacer POST,
    MVC crea la instancia Book automáticamente en la acción Create(Book book).
*@
@model PAP.DataAccess.Book

@{
    ViewBag.Title = "Crear libro";
}

<main>
    <h1 class="h2 mb-4">Crear libro</h1>

    @using (Html.BeginForm("Create", "Library", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="mb-3">
            @Html.LabelFor(m => m.Title, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", required = "required" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Author, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Author, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Genre, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Genre, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Category, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Category, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Publisher, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Publisher, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Price, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
        </div>
        <div class="mb-3 form-check">
            @Html.CheckBoxFor(m => m.IsBestSeller, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.IsBestSeller, new { @class = "form-check-label" })
        </div>
        <div class="mb-3 form-check">
            @Html.CheckBoxFor(m => m.IsInStock, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.IsInStock, new { @class = "form-check-label" })
        </div>

        <button type="submit" class="btn btn-primary">Enviar (Model Binding)</button>
        @Html.ActionLink("Cancelar", "Index", "Library", null, new { @class = "btn btn-outline-dark" })
    }
</main>
