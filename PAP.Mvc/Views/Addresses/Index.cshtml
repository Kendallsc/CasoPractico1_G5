@model IEnumerable<PAP.DataAccess.Address>
@using PAP.Mvc.Helpers

@{
    ViewBag.Title = "Direcciones";
    var rows = Model?.ToList() ?? new List<PAP.DataAccess.Address>();
    var customersOptions = (IEnumerable<SelectListItem>)ViewBag.CustomersOptions;
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">Direcciones</h1>
            <p class="text-muted mb-0">@rows.Count registro@(rows.Count == 1 ? "" : "s")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="search" id="crudFilter" class="form-control form-control-sm" placeholder="Filtrar..." />
            <button type="button" class="btn btn-primary btn-sm" data-crud="create">Nuevo</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="crudTable">
            <thead class="table-dark">
                <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Calle</th>
                        <th scope="col">Ciudad</th>
                        <th scope="col">Pais</th>
                        <th scope="col">Predeterminada</th>
                    <th scope="col" class="text-center">Editar</th>
                    <th scope="col" class="text-center">Eliminar</th>
                    <th scope="col" class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">No hay registros.</td>
                    </tr>
                }
                @foreach (var x in rows)
                {
                    var item = new
            {
                Id = x.Id,
                CustomerId = x.CustomerId,
                CustomerIdText = (x.Customer == null ? "" : x.Customer.FirstName + " " + x.Customer.LastName),
                AddressType = x.AddressType,
                Street = x.Street,
                City = x.City,
                State = x.State,
                PostalCode = x.PostalCode,
                Country = x.Country,
                IsDefault = x.IsDefault,
                __keys = new { id = x.Id }
            };
                    <tr data-item="@(Newtonsoft.Json.JsonConvert.SerializeObject(item))">
                    <td>@(x.Id)</td>
                    <td>@(x.Customer == null ? "-" : x.Customer.FirstName + " " + x.Customer.LastName)</td>
                    <td>@(x.AddressType)</td>
                    <td>@(x.Street)</td>
                    <td>@(x.City)</td>
                    <td>@(x.Country)</td>
                    <td>@if (x.IsDefault) { <span class="badge text-bg-success">Si</span> } else { <span class="badge text-bg-secondary">No</span> }</td>
                        <td class="text-center"><button type="button" class="btn btn-outline-primary btn-sm" data-crud="edit">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm" data-crud="delete">Eliminar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-info btn-sm" data-crud="detail">Detalle</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "Addresses", FormMethod.Post, new { id = "createModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle">Nuevo registro: Direccion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="create_CustomerId">Cliente <span class="text-danger">*</span></label>
                <select class="form-select" id="create_CustomerId" name="CustomerId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in customersOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_AddressType">Tipo <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_AddressType" name="AddressType" list="dl_create_AddressType" maxlength="20" required value="Shipping" />
                <datalist id="dl_create_AddressType"><option value="Shipping"></option><option value="Billing"></option></datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Street">Calle <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_Street" name="Street" maxlength="200" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_City">Ciudad <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_City" name="City" maxlength="100" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_State">Provincia / Estado</label>
                <input type="text" class="form-control" id="create_State" name="State" maxlength="100" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_PostalCode">Codigo postal <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_PostalCode" name="PostalCode" maxlength="20" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Country">Pais <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_Country" name="Country" maxlength="100" required />
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="create_IsDefault" name="IsDefault" value="true" />
                    <label class="form-check-label" for="create_IsDefault">Predeterminada</label>
                </div>
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "Addresses", FormMethod.Post, new { id = "editModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Editar direccion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
            <input type="hidden" id="edit_Id" name="Id" />
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="edit_CustomerId">Cliente <span class="text-danger">*</span></label>
                <select class="form-select" id="edit_CustomerId" name="CustomerId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in customersOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_AddressType">Tipo <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_AddressType" name="AddressType" list="dl_edit_AddressType" maxlength="20" required />
                <datalist id="dl_edit_AddressType"><option value="Shipping"></option><option value="Billing"></option></datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Street">Calle <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_Street" name="Street" maxlength="200" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_City">Ciudad <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_City" name="City" maxlength="100" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_State">Provincia / Estado</label>
                <input type="text" class="form-control" id="edit_State" name="State" maxlength="100" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_PostalCode">Codigo postal <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_PostalCode" name="PostalCode" maxlength="20" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Country">Pais <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_Country" name="Country" maxlength="100" required />
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="edit_IsDefault" name="IsDefault" value="true" />
                    <label class="form-check-label" for="edit_IsDefault">Predeterminada</label>
                </div>
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Direccion',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'CustomerIdText', label: 'Cliente', type: 'text' },
                { key: 'AddressType', label: 'Tipo', type: 'text' },
                { key: 'Street', label: 'Calle', type: 'text' },
                { key: 'City', label: 'Ciudad', type: 'text' },
                { key: 'State', label: 'Provincia / Estado', type: 'text' },
                { key: 'PostalCode', label: 'Codigo postal', type: 'text' },
                { key: 'Country', label: 'Pais', type: 'text' },
                { key: 'IsDefault', label: 'Predeterminada', type: 'bool' }
            ]
        });
    </script>
}
