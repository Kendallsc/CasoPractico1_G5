@model IEnumerable<PAP.DataAccess.Author>
@using PAP.Mvc.Helpers

@{
    ViewBag.Title = "Autores";
    var rows = Model?.ToList() ?? new List<PAP.DataAccess.Author>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">Autores</h1>
            <p class="text-muted mb-0">@rows.Count registro@(rows.Count == 1 ? "" : "s")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="search" id="crudFilter" class="form-control form-control-sm" placeholder="Filtrar..." />
            <button type="button" class="btn btn-primary btn-sm" data-crud="create">Nuevo</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="crudTable">
            <thead class="table-dark">
                <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Pais</th>
                        <th scope="col">Nacimiento</th>
                    <th scope="col" class="text-center">Editar</th>
                    <th scope="col" class="text-center">Eliminar</th>
                    <th scope="col" class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay registros.</td>
                    </tr>
                }
                @foreach (var x in rows)
                {
                    var item = new
            {
                Id = x.Id,
                FirstName = x.FirstName,
                LastName = x.LastName,
                Biography = x.Biography,
                BirthDate = Fmt.Date(x.BirthDate),
                Country = x.Country,
                CreatedAt = Fmt.DateTimeLocal(x.CreatedAt),
                __keys = new { id = x.Id }
            };
                    <tr data-item="@(Newtonsoft.Json.JsonConvert.SerializeObject(item))">
                    <td>@(x.Id)</td>
                    <td>@(x.FirstName + " " + x.LastName)</td>
                    <td>@(Fmt.Dash(x.Country))</td>
                    <td>@(Fmt.Dash(Fmt.Date(x.BirthDate)))</td>
                        <td class="text-center"><button type="button" class="btn btn-outline-primary btn-sm" data-crud="edit">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm" data-crud="delete">Eliminar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-info btn-sm" data-crud="detail">Detalle</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "Authors", FormMethod.Post, new { id = "createModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle">Nuevo registro: Autor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="create_FirstName">Nombre <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_FirstName" name="FirstName" maxlength="100" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_LastName">Apellido <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_LastName" name="LastName" maxlength="100" required />
            </div>
            <div class="col-12">
                <label class="form-label" for="create_Biography">Biografia</label>
                <textarea class="form-control" id="create_Biography" name="Biography" rows="3"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_BirthDate">Fecha de nacimiento</label>
                <input type="date" class="form-control" id="create_BirthDate" name="BirthDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Country">Pais</label>
                <input type="text" class="form-control" id="create_Country" name="Country" maxlength="100" />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "Authors", FormMethod.Post, new { id = "editModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Editar autor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
            <input type="hidden" id="edit_Id" name="Id" />
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="edit_FirstName">Nombre <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_FirstName" name="FirstName" maxlength="100" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_LastName">Apellido <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_LastName" name="LastName" maxlength="100" required />
            </div>
            <div class="col-12">
                <label class="form-label" for="edit_Biography">Biografia</label>
                <textarea class="form-control" id="edit_Biography" name="Biography" rows="3"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_BirthDate">Fecha de nacimiento</label>
                <input type="date" class="form-control" id="edit_BirthDate" name="BirthDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Country">Pais</label>
                <input type="text" class="form-control" id="edit_Country" name="Country" maxlength="100" />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Autor',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'FirstName', label: 'Nombre', type: 'text' },
                { key: 'LastName', label: 'Apellido', type: 'text' },
                { key: 'Biography', label: 'Biografia', type: 'text' },
                { key: 'BirthDate', label: 'Fecha de nacimiento', type: 'text' },
                { key: 'Country', label: 'Pais', type: 'text' },
                { key: 'CreatedAt', label: 'Creado', type: 'datetime' }
            ]
        });
    </script>
}
