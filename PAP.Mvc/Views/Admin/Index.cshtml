@model IEnumerable<PAP.Generators.GeneratorStatus>

@{
    ViewBag.Title = "Admin";
    var rows = Model?.ToList() ?? new List<PAP.Generators.GeneratorStatus>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">Admin</h1>
            <p class="text-muted mb-0">Generacion de datos de prueba por tabla</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Tabla</th>
                    <th scope="col" class="text-end">Registros</th>
                    <th scope="col" class="text-center">Generar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td>
                            @row.TableName
                            @if (row.Dependencies.Any())
                            {
                                <div class="small text-muted">Requiere: @string.Join(", ", row.Dependencies.Select(d => "dbo." + d))</div>
                            }
                        </td>
                        <td class="text-end">@row.Count</td>
                        <td class="text-center">
                            @using (Html.BeginForm("Generate", "Admin", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="entity" value="@row.EntityName" />
                                <button type="submit" class="btn btn-primary btn-sm">Generar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
