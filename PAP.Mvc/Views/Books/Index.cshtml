@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Libro',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'Title', label: 'Titulo', type: 'text' },
                { key: 'Name', label: 'Nombre interno (si se deja vacio usa el titulo)', type: 'text' },
                { key: 'Author', label: 'Autor (texto)', type: 'text' },
                { key: 'Description', label: 'Descripcion', type: 'text' },
                { key: 'PublicationDate', label: 'Fecha de publicacion', type: 'text' },
                { key: 'Height', label: 'Alto', type: 'money' },
                { key: 'Width', label: 'Ancho', type: 'money' },
                { key: 'Price', label: 'Precio', type: 'money' },
                { key: 'IsBestSeller', label: 'Best seller', type: 'bool' },
                { key: 'IsInStock', label: 'En stock', type: 'bool' },
                { key: 'PublisherIdText', label: 'Editorial', type: 'text' },
                { key: 'CategoryIdText', label: 'Categoria', type: 'text' },
                { key: 'GenreIdText', label: 'Genero', type: 'text' },
                { key: 'ISBN', label: 'ISBN', type: 'text' },
                { key: 'Pages', label: 'Paginas', type: 'text' },
                { key: 'Language', label: 'Idioma', type: 'text' },
                { key: 'CoverImageUrl', label: 'URL de portada', type: 'text' },
                { key: 'CreatedAt', label: 'Creado', type: 'datetime' },
                { key: 'UpdatedAt', label: 'Actualizado', type: 'datetime' }
            ]
        });
    </script>
}
