    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "Orders", FormMethod.Post, new { id = "editModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Editar orden</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
            <input type="hidden" id="edit_Id" name="Id" />
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="edit_CustomerId">Cliente <span class="text-danger">*</span></label>
                <select class="form-select" id="edit_CustomerId" name="CustomerId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in customersOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_ShippingAddressId">Direccion de envio</label>
                <select class="form-select" id="edit_ShippingAddressId" name="ShippingAddressId">
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in addressesOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_OrderDate">Fecha de la orden <span class="text-danger">*</span></label>
                <input type="datetime-local" class="form-control" id="edit_OrderDate" name="OrderDate" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Status">Estado <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_Status" name="Status" list="dl_edit_Status" maxlength="30" required />
                <datalist id="dl_edit_Status"><option value="Pending"></option><option value="Paid"></option><option value="Shipped"></option><option value="Delivered"></option><option value="Cancelled"></option></datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Subtotal">Subtotal <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_Subtotal" name="Subtotal" step="0.01" min="0" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_TaxAmount">Impuesto <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_TaxAmount" name="TaxAmount" step="0.01" min="0" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_ShippingCost">Costo de envio <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_ShippingCost" name="ShippingCost" step="0.01" min="0" required />
            </div>
            <div class="col-12">
                <label class="form-label" for="edit_Notes">Notas</label>
                <textarea class="form-control" id="edit_Notes" name="Notes" rows="3" maxlength="500"></textarea>
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Orden',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'CustomerIdText', label: 'Cliente', type: 'text' },
                { key: 'ShippingAddressIdText', label: 'Direccion de envio', type: 'text' },
                { key: 'OrderDate', label: 'Fecha de la orden', type: 'datetime' },
                { key: 'Status', label: 'Estado', type: 'text' },
                { key: 'Subtotal', label: 'Subtotal', type: 'money' },
                { key: 'TaxAmount', label: 'Impuesto', type: 'money' },
                { key: 'ShippingCost', label: 'Costo de envio', type: 'money' },
                { key: 'Total', label: 'Total (se calcula automaticamente)', type: 'money' },
                { key: 'Notes', label: 'Notas', type: 'text' },
                { key: 'UpdatedAt', label: 'Actualizado', type: 'datetime' }
            ]
        });
    </script>
}
