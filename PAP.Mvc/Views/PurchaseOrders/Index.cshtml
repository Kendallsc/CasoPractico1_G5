@model IEnumerable<PAP.DataAccess.PurchaseOrder>
@using PAP.Mvc.Helpers

@{
    ViewBag.Title = "Ordenes de compra";
    var rows = Model?.ToList() ?? new List<PAP.DataAccess.PurchaseOrder>();
    var suppliersOptions = (IEnumerable<SelectListItem>)ViewBag.SuppliersOptions;
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">Ordenes de compra</h1>
            <p class="text-muted mb-0">@rows.Count registro@(rows.Count == 1 ? "" : "s")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="search" id="crudFilter" class="form-control form-control-sm" placeholder="Filtrar..." />
            <button type="button" class="btn btn-primary btn-sm" data-crud="create">Nuevo</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="crudTable">
            <thead class="table-dark">
                <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Proveedor</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Esperada</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Costo total</th>
                    <th scope="col" class="text-center">Editar</th>
                    <th scope="col" class="text-center">Eliminar</th>
                    <th scope="col" class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No hay registros.</td>
                    </tr>
                }
                @foreach (var x in rows)
                {
                    var item = new
            {
                Id = x.Id,
                SupplierId = x.SupplierId,
                SupplierIdText = (x.Supplier == null ? "" : x.Supplier.Name),
                OrderDate = Fmt.DateTimeLocal(x.OrderDate),
                ExpectedDate = Fmt.Date(x.ExpectedDate),
                Status = x.Status,
                TotalCost = x.TotalCost,
                __keys = new { id = x.Id }
            };
                    <tr data-item="@(Newtonsoft.Json.JsonConvert.SerializeObject(item))">
                    <td>@(x.Id)</td>
                    <td>@(x.Supplier == null ? "-" : x.Supplier.Name)</td>
                    <td>@(Fmt.Pretty(x.OrderDate))</td>
                    <td>@(Fmt.Dash(Fmt.Date(x.ExpectedDate)))</td>
                    <td><span class="badge text-bg-secondary">@(x.Status)</span></td>
                    <td>@(x.TotalCost.ToString("C"))</td>
                        <td class="text-center"><button type="button" class="btn btn-outline-primary btn-sm" data-crud="edit">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm" data-crud="delete">Eliminar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-info btn-sm" data-crud="detail">Detalle</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "PurchaseOrders", FormMethod.Post, new { id = "createModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle">Nuevo registro: Orden de compra</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="create_SupplierId">Proveedor <span class="text-danger">*</span></label>
                <select class="form-select" id="create_SupplierId" name="SupplierId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in suppliersOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_OrderDate">Fecha de la orden <span class="text-danger">*</span></label>
                <input type="datetime-local" class="form-control" id="create_OrderDate" name="OrderDate" required data-default="now" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_ExpectedDate">Fecha esperada</label>
                <input type="date" class="form-control" id="create_ExpectedDate" name="ExpectedDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Status">Estado <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="create_Status" name="Status" list="dl_create_Status" maxlength="30" required value="Pending" />
                <datalist id="dl_create_Status"><option value="Pending"></option><option value="Ordered"></option><option value="Received"></option><option value="Cancelled"></option></datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_TotalCost">Costo total <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="create_TotalCost" name="TotalCost" step="0.01" min="0" required value="0" />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "PurchaseOrders", FormMethod.Post, new { id = "editModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Editar orden de compra</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
            <input type="hidden" id="edit_Id" name="Id" />
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="edit_SupplierId">Proveedor <span class="text-danger">*</span></label>
                <select class="form-select" id="edit_SupplierId" name="SupplierId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in suppliersOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_OrderDate">Fecha de la orden <span class="text-danger">*</span></label>
                <input type="datetime-local" class="form-control" id="edit_OrderDate" name="OrderDate" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_ExpectedDate">Fecha esperada</label>
                <input type="date" class="form-control" id="edit_ExpectedDate" name="ExpectedDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Status">Estado <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="edit_Status" name="Status" list="dl_edit_Status" maxlength="30" required />
                <datalist id="dl_edit_Status"><option value="Pending"></option><option value="Ordered"></option><option value="Received"></option><option value="Cancelled"></option></datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_TotalCost">Costo total <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_TotalCost" name="TotalCost" step="0.01" min="0" required />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Orden de compra',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'SupplierIdText', label: 'Proveedor', type: 'text' },
                { key: 'OrderDate', label: 'Fecha de la orden', type: 'datetime' },
                { key: 'ExpectedDate', label: 'Fecha esperada', type: 'text' },
                { key: 'Status', label: 'Estado', type: 'text' },
                { key: 'TotalCost', label: 'Costo total', type: 'money' }
            ]
        });
    </script>
}
