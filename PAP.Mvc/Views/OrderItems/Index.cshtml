@model IEnumerable<PAP.DataAccess.OrderItem>
@using PAP.Mvc.Helpers

@{
    ViewBag.Title = "Items de orden";
    var rows = Model?.ToList() ?? new List<PAP.DataAccess.OrderItem>();
    var ordersOptions = (IEnumerable<SelectListItem>)ViewBag.OrdersOptions;
    var booksOptions = (IEnumerable<SelectListItem>)ViewBag.BooksOptions;
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">Items de orden</h1>
            <p class="text-muted mb-0">@rows.Count registro@(rows.Count == 1 ? "" : "s")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="search" id="crudFilter" class="form-control form-control-sm" placeholder="Filtrar..." />
            <button type="button" class="btn btn-primary btn-sm" data-crud="create">Nuevo</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="crudTable">
            <thead class="table-dark">
                <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Orden</th>
                        <th scope="col">Libro</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Precio unit.</th>
                        <th scope="col">Descuento</th>
                    <th scope="col" class="text-center">Editar</th>
                    <th scope="col" class="text-center">Eliminar</th>
                    <th scope="col" class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!rows.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No hay registros.</td>
                    </tr>
                }
                @foreach (var x in rows)
                {
                    var item = new
            {
                Id = x.Id,
                OrderId = x.OrderId,
                OrderIdText = (x.Order == null ? "" : "#" + x.Order.Id),
                BookId = x.BookId,
                BookIdText = (x.Book == null ? "" : x.Book.Title),
                Quantity = x.Quantity,
                UnitPrice = x.UnitPrice,
                Discount = x.Discount,
                __keys = new { id = x.Id }
            };
                    <tr data-item="@(Newtonsoft.Json.JsonConvert.SerializeObject(item))">
                    <td>@(x.Id)</td>
                    <td>@(x.Order == null ? "-" : "#" + x.Order.Id)</td>
                    <td>@(x.Book == null ? "-" : x.Book.Title)</td>
                    <td>@(x.Quantity)</td>
                    <td>@(x.UnitPrice.ToString("C"))</td>
                    <td>@(x.Discount.ToString("C"))</td>
                        <td class="text-center"><button type="button" class="btn btn-outline-primary btn-sm" data-crud="edit">Editar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm" data-crud="delete">Eliminar</button></td>
                        <td class="text-center"><button type="button" class="btn btn-outline-info btn-sm" data-crud="detail">Detalle</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "OrderItems", FormMethod.Post, new { id = "createModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalTitle">Nuevo registro: Item de orden</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="create_OrderId">Orden <span class="text-danger">*</span></label>
                <select class="form-select" id="create_OrderId" name="OrderId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in ordersOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_BookId">Libro <span class="text-danger">*</span></label>
                <select class="form-select" id="create_BookId" name="BookId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in booksOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Quantity">Cantidad <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="create_Quantity" name="Quantity" step="1" min="1" required value="1" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_UnitPrice">Precio unitario <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="create_UnitPrice" name="UnitPrice" step="0.01" min="0" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="create_Discount">Descuento <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="create_Discount" name="Discount" step="0.01" min="0" required value="0" />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Edit", "OrderItems", FormMethod.Post, new { id = "editModalForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Editar item de orden</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
            <input type="hidden" id="edit_Id" name="Id" />
                    <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="edit_OrderId">Orden <span class="text-danger">*</span></label>
                <select class="form-select" id="edit_OrderId" name="OrderId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in ordersOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_BookId">Libro <span class="text-danger">*</span></label>
                <select class="form-select" id="edit_BookId" name="BookId" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var o in booksOptions)
                    {
                        <option value="@o.Value">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Quantity">Cantidad <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_Quantity" name="Quantity" step="1" min="1" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_UnitPrice">Precio unitario <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_UnitPrice" name="UnitPrice" step="0.01" min="0" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="edit_Discount">Descuento <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="edit_Discount" name="Discount" step="0.01" min="0" required />
            </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>

@Html.Partial("_DetailModal")
@Html.Partial("_DeleteModal")

@section scripts {
    @Scripts.Render("~/bundles/crud")
    <script>
        Crud.init({
            title: 'Item de orden',
            detail: [
                { key: 'Id', label: 'Id', type: 'text' },
                { key: 'OrderIdText', label: 'Orden', type: 'text' },
                { key: 'BookIdText', label: 'Libro', type: 'text' },
                { key: 'Quantity', label: 'Cantidad', type: 'text' },
                { key: 'UnitPrice', label: 'Precio unitario', type: 'money' },
                { key: 'Discount', label: 'Descuento', type: 'money' }
            ]
        });
    </script>
}
